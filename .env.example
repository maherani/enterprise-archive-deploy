# ==============================================================================
# Enterprise Archive System - Master Deployment Environment Template (.env.example)
# Copy this file to .env before deploying:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Archive Core)
# ------------------------------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud_user
POSTGRES_PASSWORD=ChangeMe_StrongPostgresPassword_123!

# ------------------------------------------------------------------------------
# 2. Nextcloud Primary Administrator Credentials (Archive Core)
# ------------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ChangeMe_StrongAdminPassword_123!

# Space-separated list of hostnames / IPs
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 docs.maskan"

# ------------------------------------------------------------------------------
# 3. AI Box Gateway & Engine Settings
# ------------------------------------------------------------------------------
AI_BACKEND_PROVIDER=anythingllm
BACKEND_HOST=anythingllm
BACKEND_PORT=3001
AI_BACKEND_PROTOCOL=http
GATEWAY_PORT=3001
MAX_FILE_SIZE_BYTES=2097152
INTERNAL_SERVICE_KEY=ai_box_internal_api_secret_key
DESTINATION_API_KEY=ai_box_internal_api_secret_key
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,http://docs.maskan,http://docs.maskan:80

# Vector Engine & Session ACL Caching
VECTOR_DB=lancedb
EMBEDDING_MODEL_PREF=qwen2.5:0.5b-instruct
SESSION_ACL_CACHE_TTL=3600

# ------------------------------------------------------------------------------
# 4. RabbitMQ & Integration Layer
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
AMQP_QUEUE_NAME=ai_box.file_events
FILE_PROXY_PORT=8090
